# 复制为 .env 后按需修改:cp .env.example .env
# 变量名与 app/settings.py 中的字段同名(大写),环境变量优先于本文件。

# 调试模式,开启后返回详细错误信息
DEBUG = False

# MongoDB 连接串与数据库名
MONGO_URI = mongodb://localhost:27017
MONGO_DATABASE = monevo

# ===== JWT 配置 =====
JWT_ALGORITHM = HS256
JWT_ACCESS_EXPIRES = 3600
JWT_REFRESH_EXPIRES = 86400

# JWT 签名密钥:必填,长度至少 32 字节,否则应用启动失败。
# 生成方式:python -c "import secrets; print(secrets.token_urlsafe(32))"
# 每个环境(开发/测试/生产)使用各自独立的随机值,不要复用。
JWT_ACCESS_KEY = replace-with-a-random-32-byte-access-key
JWT_REFRESH_KEY = replace-with-a-random-32-byte-refresh-key

# 启动时自动创建的默认调试账号,仅本地/测试使用
DEFAULT_USERNAME = admin
DEFAULT_PASSWORD = change-me
